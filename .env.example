# OfflineCoder Environment Configuration
APP_NAME=OfflineCoder
DEBUG=false

# Local LLM Runtime (ollama or llama_cpp)
RUNTIME_TYPE=ollama
OLLAMA_HOST=http://localhost:11434
LLAMA_CPP_HOST=http://localhost:8080
MODELS_DIR=./models
DEFAULT_MODEL=gemma3

# Model inference defaults
DEFAULT_TEMPERATURE=0.1
DEFAULT_TOP_P=0.95
DEFAULT_MAX_TOKENS=2048
DEFAULT_CONTEXT_LENGTH=4096
DEFAULT_LANGUAGE=Auto
MAX_SYNTAX_RETRIES=2

# Sandboxed Code Execution (Python/JS only)
ALLOW_CODE_EXECUTION=false
SANDBOX_TIMEOUT_SECONDS=5
SANDBOX_MEMORY_LIMIT_MB=256

# Strict zero-egress offline mode
OFFLINE_STRICT_MODE=true

